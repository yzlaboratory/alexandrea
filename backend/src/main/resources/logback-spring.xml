<?xml version="1.0" encoding="UTF-8"?>
<!--
  Profile-aware log encoding. In dev we want readable lines on the console;
  in prod we want one JSON object per line on stdout so Grafana Alloy can
  ship it to Loki without re-parsing (ADR 0014, observability section).
-->
<configuration>

  <springProperty scope="context" name="appName" source="spring.application.name"/>

  <springProfile name="!prod">
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
      <encoder>
        <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
      </encoder>
    </appender>
  </springProfile>

  <springProfile name="prod">
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
      <encoder class="net.logstash.logback.encoder.LogstashEncoder">
        <!-- One JSON object per line. Alloy tails Docker's logging socket and
             forwards verbatim; no parsing layer in between. -->
        <customFields>{"app":"${appName}"}</customFields>
        <includeMdcKeyName>requestId</includeMdcKeyName>
        <includeMdcKeyName>userId</includeMdcKeyName>
      </encoder>
    </appender>
  </springProfile>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
