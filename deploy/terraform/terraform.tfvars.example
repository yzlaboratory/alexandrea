# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
#
# hcloud_token         — console.hetzner.cloud → Security → API tokens (read+write).
#                        Prefer exporting as TF_VAR_hcloud_token over writing to disk.
# ssh_public_key       — `cat ~/.ssh/id_ed25519.pub` (or whichever key you want installed).
# storage_box_password — generate with `openssl rand -base64 24`. Used only
#                        for the Hetzner web UI; scp auth uses the SSH key.

hcloud_token         = "..."
ssh_public_key       = "ssh-ed25519 AAAA... user@host"
storage_box_password = "..."

# Defaults are fine for MVP; override as needed:
# server_name          = "entlib"
# server_type          = "cx22"
# server_image         = "ubuntu-24.04"
# server_location      = "nbg1"
# storage_box_name     = "entlib-backups"
# storage_box_type     = "bx11"
# storage_box_location = "hel1"
