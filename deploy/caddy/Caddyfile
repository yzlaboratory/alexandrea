# Caddyfile for the entlib VPS.
#
# The domain is supplied via the ENTLIB_DOMAIN environment variable so this
# file can live in the repo without hard-coding whatever name we end up
# registering (see OPEN-QUESTIONS.md). Example on the host:
#
#   sudo mkdir -p /etc/caddy
#   sudo cp deploy/caddy/Caddyfile /etc/caddy/Caddyfile
#   echo "ENTLIB_DOMAIN=entlib.example.com" | sudo tee /etc/default/caddy
#   sudo systemctl restart caddy
#
# Caddy's apt package already wires /etc/default/caddy through as the
# service EnvironmentFile, so {$ENTLIB_DOMAIN} is interpolated at load time.

{$ENTLIB_DOMAIN} {
	encode gzip zstd

	# Reverse-proxy everything to the Go process on localhost. entlib owns
	# its own routing — /api/*, /login, /logout, and the SPA fallback all
	# live inside the single binary (see ADR 0005 and backend/internal/web).
	reverse_proxy 127.0.0.1:8080

	# Security headers. HSTS is 1-year with preload-eligible flags; only
	# enable preload-submission once the domain is final.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options    "nosniff"
		Referrer-Policy           "strict-origin-when-cross-origin"
		X-Frame-Options           "DENY"
		-Server
	}

	log {
		output file /var/log/caddy/entlib.log {
			roll_size 10mb
			roll_keep 5
		}
		format console
	}
}
