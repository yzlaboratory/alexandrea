# macOS
.DS_Store

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo

# Environment / secrets
.env
.env.*
!.env.example

# Node (in case tooling lands here later)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python (in case tooling lands here later)
__pycache__/
*.pyc
.venv/
venv/

# Go
backend/entlib
backend/entlib-*
*.test
*.out
coverage.txt

# Local SQLite artifacts (dev/test)
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Build / dist
dist/
build/
out/
# Keep the embed sentinel so `go build` works on a fresh checkout before
# the frontend has been built.
!backend/internal/web/dist/
backend/internal/web/dist/*
!backend/internal/web/dist/.gitkeep

# Logs
*.log

# Terraform (keep .terraform.lock.hcl tracked — it pins provider versions)
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
*.tfvars
!*.tfvars.example
