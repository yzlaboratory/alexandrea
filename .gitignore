# macOS
.DS_Store

# Editors / IDEs
.idea/
.vscode/
*.iml
*.swp
*.swo

# Environment / secrets — actual secrets live in ~/.credentials, never here
.env
.env.*
!.env.example

# Java / Gradle / Spring Boot (backend)
.gradle/
build/
out/
*.class
hs_err_pid*
replay_pid*

# Node / Vite (frontend)
node_modules/
dist/
.vite/
*.local
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python (in case tooling lands here later)
__pycache__/
*.pyc
.venv/
venv/

# SQLite (the production data file plus dev/test artefacts)
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db

# Logs
*.log

# Terraform — keep .terraform.lock.hcl tracked (it pins provider versions)
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
*.tfvars
!*.tfvars.example
